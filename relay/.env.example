# Foreground Telegram bot configuration.
# Managed installs write these to ~/.config/herdr-remote/secrets.env (mode 0600).
HERDR_TG_TOKEN=your-bot-token-here
HERDR_TG_CHAT_ID=your-private-chat-id
HERDR_TG_USER_ID=your-telegram-user-id
HERDR_TG_REQUIRE_PRIVATE_CHAT=1
HERDR_TG_REQUIRE_LOCAL_RELAY=1
# Persistent "trust always" is hidden unless explicitly enabled.
HERDR_TG_ALLOW_PERSISTENT_TRUST=0
# Read more terminal context and split long output across safe HTML messages.
HERDR_TG_READ_LINES=60
HERDR_TG_OUTPUT_MAX_CHARS=12000

# Relay address used by local WebSocket clients.
HERDR_RELAY=ws://127.0.0.1:8375?token=the-same-relay-token
HERDR_RELAY_HOST=127.0.0.1

# Relay authentication is mandatory outside isolated development.
HERDR_RELAY_TOKEN=64-lowercase-hex-characters
HERDR_ALLOW_REMOTE_BIND=0
HERDR_ALLOW_INSECURE_NO_AUTH=0
HERDR_MDNS_ENABLED=0
# Colon-separated directories that Telegram may browse and use for new agents.
HERDR_WORKSPACE_ROOTS=~/Workspace

# Remote herdr instances polled by the relay over SSH (comma-separated).
HERDR_REMOTES=user@server1,user@server2
